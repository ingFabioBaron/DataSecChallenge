# ===============================================
#  DataSecChallenge - Environment Example File
#  Copy this file to ".env" and adjust as needed.
# ===============================================

# -----------------------------------------------
# Logging level for the entire project
# Possible values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# -----------------------------------------------
LOG_LEVEL=INFO


# -----------------------------------------------
# Challenge 3: SQLite Database
# Ruta donde se almacenará la base SQLite.
# Si no existe, el DAO la creará automáticamente.
# -----------------------------------------------
DB_PATH=./database.sqlite3


# -----------------------------------------------
# Challenge 4: HuggingFace Summarizer
#
# ⚠ Obligatorio → el proyecto NO funcionará sin este token.
# Obtén uno aquí:
# https://huggingface.co/settings/tokens
#
# Ejemplo:
# HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# -----------------------------------------------
HF_API_TOKEN=


# -----------------------------------------------
# (Opcional) Modelo para el Summarizer.
# Si no lo defines, se usa por defecto:
#   Qwen/Qwen2.5-7B-Instruct
#
# Puedes personalizarlo así:
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# -----------------------------------------------
# HF_MODEL=
